# SOLPRINT configuration template.
#
# Copy to .env (or run scripts/setup.ps1, which merges missing keys into an
# existing .env without touching values you already have). .env is ignored by
# git and must never be committed. Full schema: docs/development/CONFIGURATION.md
#
# Precedence: process environment > .env > built-in defaults.

# --- Provider credentials -------------------------------------------------
# Optional. Without HELIUS_API_KEY, Helius (RPC and streams) stays disabled;
# without JUPITER_API_KEY, Jupiter runs on the keyless tier (capped at 30/min).
# Rotating these credentials is the owner's responsibility.
HELIUS_API_KEY=
JUPITER_API_KEY=

# --- Provider endpoints (https / wss only; never put a key in these URLs
#     except SOLANA_FALLBACK_RPC_URL, which is treated as a secret) ---
HELIUS_RPC_URL=https://mainnet.helius-rpc.com
HELIUS_WS_URL=wss://mainnet.helius-rpc.com
JUPITER_BASE_URL=https://api.jup.ag
DEXSCREENER_BASE_URL=https://api.dexscreener.com
SOLANA_FALLBACK_RPC_URL=https://api.mainnet.solana.com

# --- GATEWAY (Phase 01). Defaults stay below documented free-tier limits. ---
# See docs/architecture/GATEWAY.md and docs/architecture/API_BUDGET_POLICY.md.
GATEWAY_ENABLED=true
GATEWAY_DEFAULT_DEADLINE_MS=10000
GATEWAY_CONNECT_TIMEOUT_MS=5000
GATEWAY_GLOBAL_QUEUE_LIMIT=512
GATEWAY_PROVIDER_QUEUE_LIMIT=128
GATEWAY_MAX_RESPONSE_BYTES=8388608
GATEWAY_CACHE_MAX_ENTRIES=10000
GATEWAY_FLUSH_INTERVAL_SECS=30
GATEWAY_USAGE_RETENTION_DAYS=90
GATEWAY_METRICS_RETENTION_DAYS=14
# WebSocket streams cost credits per byte; off until a consumer needs them.
GATEWAY_STREAMS_ENABLED=false

# Helius credit budget: set to your plan's monthly credits. 20 % is reserved
# for high-priority reads. Nothing ever enables paid overage.
HELIUS_MONTHLY_CREDITS=1000000
HELIUS_RESERVE_PERCENT=20
HELIUS_BILLING_CYCLE_START_DAY=1
HELIUS_RPC_RPS=5
HELIUS_MAX_IN_FLIGHT=4
HELIUS_WS_MAX_SUBSCRIPTIONS=100
HELIUS_GET_BLOCK_ENABLED=false

JUPITER_RPM=50
JUPITER_MAX_IN_FLIGHT=2
# Quotes only (/swap/v2/order without a taker). Execution does not exist.
JUPITER_QUOTE_ENABLED=true

DEXSCREENER_RPM=240
DEXSCREENER_MAX_IN_FLIGHT=4
DEXSCREENER_DISCOVERY_ENABLED=false

SOLANA_FALLBACK_ENABLED=true
SOLANA_FALLBACK_RPS=2

# --- DATA ENGINE (Phase 02): read-only ingestion and decoding ---
# Every provider request goes through GATEWAY (budget admission, rate limits).
# Live intake subscribes enabled wallet targets to GATEWAY streams; off by
# default. Backfills run only when the owner creates one (CLI, with --yes).
DATA_ENGINE_ENABLED=true
DATA_ENGINE_AUTO_INGEST_ENABLED=false
DATA_ENGINE_MAX_ACTIVE_TARGETS=25
DATA_ENGINE_FETCH_CONCURRENCY=4
DATA_ENGINE_DECODE_CONCURRENCY=4
DATA_ENGINE_QUEUE_CAPACITY=2048
DATA_ENGINE_JOB_LEASE_SECONDS=60
DATA_ENGINE_JOB_MAX_ATTEMPTS=5
# confirmed | finalized (getTransaction rejects processed)
DATA_ENGINE_DEFAULT_COMMITMENT=confirmed
DATA_ENGINE_FINALITY_RECONCILE_INTERVAL_SECS=15
DATA_ENGINE_FINALITY_BATCH_SIZE=64
DATA_ENGINE_BACKFILL_ENABLED=true
DATA_ENGINE_MAX_CONCURRENT_BACKFILLS=1
DATA_ENGINE_BACKFILL_PAGE_SIZE=100
DATA_ENGINE_BACKFILL_MAX_PAGES=10
DATA_ENGINE_BACKFILL_MAX_SIGNATURES=1000
# USD valuation is not implemented in Phase 02; keep this off.
DATA_ENGINE_PRICE_ENRICHMENT_ENABLED=false
DATA_ENGINE_PRICE_MAX_AGE_SECS=15
DATA_ENGINE_OUTBOX_BATCH_SIZE=100
DATA_ENGINE_OUTBOX_POLL_INTERVAL_MS=250
DATA_ENGINE_METRICS_REFRESH_SECS=15
DATA_ENGINE_EVIDENCE_MAX_BYTES=1048576
# 0 keeps raw evidence indefinitely.
DATA_ENGINE_EVIDENCE_RETENTION_DAYS=90
DATA_ENGINE_JOB_RETENTION_DAYS=14
DATA_ENGINE_OUTBOX_RETENTION_DAYS=7

# --- RADAR (Phase 03): read-only wallet discovery ---
# Provider-backed discovery (listings, pool checks, sampling, history) is off
# by default; enabling it is the owner's opt-in to spend provider credits
# under RADAR_NORMAL_BUDGET_SHARE_BPS and GATEWAY's budget states.
RADAR_ENABLED=true
RADAR_AUTO_DISCOVERY_ENABLED=false
RADAR_MARKET_DISCOVERY_INTERVAL_SECS=300
RADAR_CANDIDATE_REEVALUATION_INTERVAL_SECS=900
RADAR_REGISTRY_MAINTENANCE_INTERVAL_SECS=3600
RADAR_MAX_MARKET_TARGETS=100
RADAR_MAX_ACTIVE_MARKET_TARGETS=20
RADAR_MAX_MARKET_SAMPLES_PER_CYCLE=5
RADAR_MAX_ACTIVE_CANDIDATES=500
RADAR_MAX_INVESTIGATING_CANDIDATES=25
RADAR_MAX_LIVE_MONITORED_WALLETS=10
RADAR_MAX_CONCURRENT_SAMPLE_JOBS=2
RADAR_MAX_CONCURRENT_HISTORY_JOBS=2
RADAR_MAX_PENDING_JOBS=1000
RADAR_INITIAL_SAMPLE_SIGNATURES=25
RADAR_EXPANDED_SAMPLE_SIGNATURES=100
RADAR_INITIAL_HISTORY_DAYS=7
RADAR_INITIAL_HISTORY_MAX_SIGNATURES=50
RADAR_EXPANDED_HISTORY_DAYS=30
RADAR_EXPANDED_HISTORY_MAX_SIGNATURES=200
RADAR_EXTENDED_HISTORY_DAYS=90
RADAR_EXTENDED_HISTORY_MAX_SIGNATURES=500
RADAR_NORMAL_BUDGET_SHARE_BPS=4000
# Bucket shares (sum 10000; exploration >= 500)
RADAR_SHARE_ESTABLISHED_BPS=3500
RADAR_SHARE_EMERGING_BPS=2500
RADAR_SHARE_LOCAL_ACTIVITY_BPS=2000
RADAR_SHARE_HISTORICAL_BPS=1000
RADAR_SHARE_EXPLORATION_BPS=1000
RADAR_MIN_POOL_LIQUIDITY_USD=5000
RADAR_MIN_VOLUME_24H_USD=10000
RADAR_MIN_TXNS_1H=20
RADAR_MAX_MARKET_OBSERVATION_AGE_SECS=300
RADAR_MIN_QUALIFYING_SWAPS=10
RADAR_MIN_DISTINCT_TRADING_DAYS=3
RADAR_MIN_MATCHED_OUTCOMES=3
RADAR_MIN_MATCHED_COVERAGE_BPS=6000
RADAR_QUALIFICATION_MAX_INACTIVE_DAYS=7
RADAR_ACTIVITY_HALF_LIFE_DAYS=7
RADAR_REDUCE_MONITORING_AFTER_DAYS=7
RADAR_DORMANT_AFTER_DAYS=14
RADAR_ARCHIVE_AFTER_DAYS=60
RADAR_MONITORING_MIN_DURATION_SECS=3600
RADAR_MONITORING_COOLDOWN_SECS=3600
RADAR_MARKET_OBSERVATION_RETENTION_DAYS=30
RADAR_SNAPSHOT_RETENTION_DAYS=90
RADAR_JOB_RETENTION_DAYS=30

# --- Trading safety. Phase 00 is non-executing: any other value is rejected. ---
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false

# --- Application ---
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8080
# Only for container networking; the backend refuses non-loopback binds otherwise.
APP_ALLOW_NON_LOOPBACK=false
HTTP_REQUEST_TIMEOUT_SECS=10
HTTP_BODY_LIMIT_BYTES=65536

# --- Logging: error | warn | info | debug | trace ; pretty | json ---
LOG_LEVEL=info
LOG_FORMAT=pretty

# --- PostgreSQL (Docker Compose) ---
# setup.ps1 generates random values for both passwords if they are missing.
POSTGRES_ADMIN_PASSWORD=change-me-admin
SOLPRINT_DB_PASSWORD=change-me-app
POSTGRES_HOST_PORT=55432

# Native backend -> Compose PostgreSQL on loopback. Keep the password in sync
# with SOLPRINT_DB_PASSWORD (setup.ps1 does this for you).
DATABASE_URL=postgres://solprint_app:change-me-app@127.0.0.1:55432/solprint
DATABASE_MAX_CONNECTIONS=5
DATABASE_ACQUIRE_TIMEOUT_SECS=5
DATABASE_STARTUP_TIMEOUT_SECS=30
DATABASE_RUN_MIGRATIONS=true

# --- Frontend container port (loopback only) ---
SOLPRINT_WEB_PORT=3000
