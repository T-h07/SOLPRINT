# SOLPRINT configuration template.
#
# Copy to .env (or run scripts/setup.ps1, which merges missing keys into an
# existing .env without touching values you already have). .env is ignored by
# git and must never be committed. Full schema: docs/development/CONFIGURATION.md
#
# Precedence: process environment > .env > built-in defaults.

# --- Provider credentials -------------------------------------------------
# Optional. Without HELIUS_API_KEY, Helius (RPC and streams) stays disabled;
# without JUPITER_API_KEY, Jupiter runs on the keyless tier (capped at 30/min).
# Rotating these credentials is the owner's responsibility.
HELIUS_API_KEY=
JUPITER_API_KEY=

# --- Provider endpoints (https / wss only; never put a key in these URLs
#     except SOLANA_FALLBACK_RPC_URL, which is treated as a secret) ---
HELIUS_RPC_URL=https://mainnet.helius-rpc.com
HELIUS_WS_URL=wss://mainnet.helius-rpc.com
JUPITER_BASE_URL=https://api.jup.ag
DEXSCREENER_BASE_URL=https://api.dexscreener.com
SOLANA_FALLBACK_RPC_URL=https://api.mainnet.solana.com

# --- GATEWAY (Phase 01). Defaults stay below documented free-tier limits. ---
# See docs/architecture/GATEWAY.md and docs/architecture/API_BUDGET_POLICY.md.
GATEWAY_ENABLED=true
GATEWAY_DEFAULT_DEADLINE_MS=10000
GATEWAY_CONNECT_TIMEOUT_MS=5000
GATEWAY_GLOBAL_QUEUE_LIMIT=512
GATEWAY_PROVIDER_QUEUE_LIMIT=128
GATEWAY_MAX_RESPONSE_BYTES=8388608
GATEWAY_CACHE_MAX_ENTRIES=10000
GATEWAY_FLUSH_INTERVAL_SECS=30
GATEWAY_USAGE_RETENTION_DAYS=90
GATEWAY_METRICS_RETENTION_DAYS=14
# WebSocket streams cost credits per byte; off until a consumer needs them.
GATEWAY_STREAMS_ENABLED=false

# Helius credit budget: set to your plan's monthly credits. 20 % is reserved
# for high-priority reads. Nothing ever enables paid overage.
HELIUS_MONTHLY_CREDITS=1000000
HELIUS_RESERVE_PERCENT=20
HELIUS_BILLING_CYCLE_START_DAY=1
HELIUS_RPC_RPS=5
HELIUS_MAX_IN_FLIGHT=4
HELIUS_WS_MAX_SUBSCRIPTIONS=100
HELIUS_GET_BLOCK_ENABLED=false

JUPITER_RPM=50
JUPITER_MAX_IN_FLIGHT=2
# Quotes only (/swap/v2/order without a taker). Execution does not exist.
JUPITER_QUOTE_ENABLED=true

DEXSCREENER_RPM=240
DEXSCREENER_MAX_IN_FLIGHT=4
DEXSCREENER_DISCOVERY_ENABLED=false

SOLANA_FALLBACK_ENABLED=true
SOLANA_FALLBACK_RPS=2

# --- Trading safety. Phase 00 is non-executing: any other value is rejected. ---
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false

# --- Application ---
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8080
# Only for container networking; the backend refuses non-loopback binds otherwise.
APP_ALLOW_NON_LOOPBACK=false
HTTP_REQUEST_TIMEOUT_SECS=10
HTTP_BODY_LIMIT_BYTES=65536

# --- Logging: error | warn | info | debug | trace ; pretty | json ---
LOG_LEVEL=info
LOG_FORMAT=pretty

# --- PostgreSQL (Docker Compose) ---
# setup.ps1 generates random values for both passwords if they are missing.
POSTGRES_ADMIN_PASSWORD=change-me-admin
SOLPRINT_DB_PASSWORD=change-me-app
POSTGRES_HOST_PORT=55432

# Native backend -> Compose PostgreSQL on loopback. Keep the password in sync
# with SOLPRINT_DB_PASSWORD (setup.ps1 does this for you).
DATABASE_URL=postgres://solprint_app:change-me-app@127.0.0.1:55432/solprint
DATABASE_MAX_CONNECTIONS=5
DATABASE_ACQUIRE_TIMEOUT_SECS=5
DATABASE_STARTUP_TIMEOUT_SECS=30
DATABASE_RUN_MIGRATIONS=true

# --- Frontend container port (loopback only) ---
SOLPRINT_WEB_PORT=3000
